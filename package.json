{
  "name": "g-zen-phone-store-monorepo",
  "version": "1.0.0",
  "description": "G-Zen Phone Store - Full Stack Vue 3 + Node.js E-Commerce Application",
  "private": true,
  "scripts": {
    "dev": "npm run start:all",
    "start:all": "node scripts/start-both.js",
    "dev:backend": "npm --prefix backend run start",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "postinstall": "npm --prefix frontend install && npm --prefix backend install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7"
  },
  "keywords": [
    "vue3",
    "nodejs",
    "express",
    "sqlite",
    "khqr",
    "phnompenh"
  ],
  "author": "G-Zen Tech",
  "license": "MIT"
}
